{
    "name": "Patent Analyser Env",
    "image": "mcr.microsoft.com/devcontainers/python:3.11",
    "features": {
      "ghcr.io/devcontainers/features/python:1": {
        "version": "3.11"
      }
    },
    "postCreateCommand": "pip install --upgrade pip setuptools && pip install -r requirements.txt",
    "customizations": {
      "vscode": {
        "settings": {
          "python.defaultInterpreterPath": "/usr/local/bin/python"
        }
      }
    }
  }
  